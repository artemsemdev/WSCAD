<Window x:Class="VectorViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VectorViewer.Wpf.Controls"
        xmlns:viewModels="clr-namespace:VectorViewer.Wpf.ViewModels"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="700" Width="900"
        Background="#1E1E1E">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="_Open…"
                        Command="{Binding OpenCommand}"
                        Padding="14,4"
                        ToolTip="Open a vector drawing (Ctrl+O)" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ZoomText}"
                           Foreground="White"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Drawing area. The scene is fitted to whatever space is left. -->
        <controls:SceneView Scene="{Binding Scene}"
                            ZoomPercentage="{Binding ZoomPercentage, Mode=OneWayToSource}"
                            Margin="0" />

    </DockPanel>
</Window>
